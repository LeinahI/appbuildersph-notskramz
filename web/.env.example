# Hub crop Q&A (defaults to http://127.0.0.1:8787 in code if unset).
# For the Android app (pnpm android:apk), put the same keys in web/.env.native with the hub's address on its Wi-Fi,
# for example VITE_HUB_URL=http://192.168.1.10:8787. 127.0.0.1 on a phone is the phone itself.
VITE_HUB_URL=http://127.0.0.1:8787

# Ugatan registration API (ws). Admin UI at /admin and farmer /claim call this.
VITE_WS_URL=http://127.0.0.1:8080
