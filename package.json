{
  "name": "ugatan",
  "version": "0.1.0",
  "private": true,
  "description": "Offline Taglish advisor for Filipino rice and corn farmers",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @ugatan/shared build && pnpm --filter @ugatan/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r build && pnpm -r test",
    "eval": "pnpm --filter @ugatan/hub eval",
    "eval:voice": "pnpm --filter @ugatan/hub eval:voice",
    "eval:photo": "pnpm --filter @ugatan/hub eval:photo"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "node-llama-cpp",
      "onnxruntime-node"
    ],
    "patchedDependencies": {
      "@receptron/laya@0.1.2": "patches/@receptron__laya@0.1.2.patch"
    }
  }
}
