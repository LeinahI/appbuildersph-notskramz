{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hub",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@ugatan/hub",
        "start"
      ],
      "port": 8787
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@ugatan/web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "hub-models",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@ugatan/hub",
        "exec",
        "tsx",
        "src/main.ts"
      ],
      "port": 8788,
      "env": {
        "HUB_PORT": "8788",
        "HUB_HOST": "127.0.0.1",
        "HUB_MATCHER": "keyword",
        "HUB_EXPLAINER": "off",
        "HUB_VISION": "off",
        "HUB_VOICE": "off"
      }
    },
    {
      "name": "web-phone",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@ugatan/web",
        "exec",
        "vite",
        "--port",
        "3001"
      ],
      "port": 3001,
      "env": {
        "VITE_HUB_URL": "http://127.0.0.1:8788"
      }
    },
    {
      "name": "hub-phone",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@ugatan/hub",
        "exec",
        "tsx",
        "src/main.ts"
      ],
      "port": 8790,
      "env": {
        "HUB_PORT": "8790",
        "HUB_HOST": "0.0.0.0",
        "HUB_MATCHER": "keyword",
        "HUB_EXPLAINER": "off",
        "HUB_VISION": "off",
        "HUB_VOICE": "off",
        "PHONE_LITERT_FILE": "E:/models/gemma-4-E2B-it-litert-lm/gemma-4-E2B-it.litertlm"
      }
    },
    {
      "name": "hub-8787",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@ugatan/hub",
        "exec",
        "tsx",
        "src/main.ts"
      ],
      "port": 8787,
      "env": {
        "HUB_PORT": "8787",
        "HUB_HOST": "0.0.0.0",
        "HUB_MATCHER": "hybrid",
        "HUB_EXPLAINER": "gemma",
        "GEMMA_RUNTIME": "llamacpp",
        "GEMMA_GGUF": "E:/models/gemma-4-E2B-it-GGUF/hf_ggml-org_gemma-4-E2B-it.Q4_0.gguf",
        "GEMMA_MODEL_DIR": "E:/models/gemma-4-E2B-it-ONNX",
        "HUB_VISION": "on",
        "HUB_VOICE": "on",
        "LAYA_MODEL_DIR": "E:/models/laya-onnx",
        "LAYA_DEVICE": "cpu",
        "LAYA_PASS_MARK": "0.5",
        "LAYA_CONFIDENCE_THRESHOLD": "0.3",
        "PHONE_LITERT_FILE": "E:/models/gemma-4-E2B-it-litert-lm/gemma-4-E2B-it.litertlm"
      }
    }
  ]
}
