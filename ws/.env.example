APP_ENV=development

HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Matches deployments/docker-compose.yml (host port 5433 → container 5432).
# DB name must match POSTGRES_DB below.
DATABASE_URL=postgres://postgres:root@127.0.0.1:5433/ugatan_db?sslmode=disable

# Comma-separated. Ugatan web is on port 3000.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# At least 16 characters. Never commit real secrets.
PII_ENCRYPTION_KEY=dev-pii-key-change-me
JWT_SECRET=dev-jwt-secret-change-me

# QR invitation links. The hub serves the Android app at {CLAIM_BASE_URL}/app. No token in the path.
# Phones open this, so use an address they can reach (the hotspot address), never localhost.
CLAIM_BASE_URL=http://192.168.137.1:8787

# Postgres credentials (used by docker compose + DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=ugatan_db