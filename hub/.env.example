# Copy to hub/.env (or set in the shell). Every value has a safe default. Nothing here is a secret.

# HTTP listener. 0.0.0.0 serves the whole local network.
HUB_HOST=0.0.0.0
HUB_PORT=8787

# Matcher: keyword (default) or laya.
# laya needs LAYA_PASS_MARK and LAYA_CONFIDENCE_THRESHOLD. Both are team decisions, set before the labeled test.
HUB_MATCHER=keyword
# LAYA_PASS_MARK=
# LAYA_CONFIDENCE_THRESHOLD=

# Laya weights. Default bundle is about 1.69 GB, downloaded once on first use.
# Point LAYA_MODEL_DIR at a local bundle to download nothing.
LAYA_CACHE=.laya-cache
# LAYA_MODEL_DIR=

# If Laya fails to load, keep answering with keyword matching. "keyword" is the default.
HUB_LAYA_FALLBACK=keyword

# Explainer: off (default) or gemma-e4b. The E4B route is not wired until it is decided.
HUB_EXPLAINER=off

# Pilot logs, one JSON line per event. Keep off git.
HUB_LOG_DIR=logs
