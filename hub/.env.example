# Reference list of hub settings. Copy to hub/.env (gitignored) and the hub loads it at startup.
# The hub, `pnpm eval`, and the hub tests all read this file. Variables already set in your shell win over the file.
# Every value has a safe default. Nothing here is a secret. Paths below are examples — edit for your machine.

# HTTP listener. 0.0.0.0 serves the whole local network.
HUB_HOST=0.0.0.0
HUB_PORT=8787

# Local hub settings. Laya on, using the local ONNX bundle. Nothing is downloaded.
# Matcher: keyword (default), laya, or hybrid (keyword first, Laya only when keyword is not sure).
HUB_MATCHER=hybrid
LAYA_MODEL_DIR="C:/Models/laya-onnx"
# Provisional values, set from the 27-row labeled set on 2026-10-09. The team confirms them.
# At 0.3 the English bundle gave 19 clear correct and 0 clear wrong answers across both sets.
LAYA_PASS_MARK=0.5
LAYA_CONFIDENCE_THRESHOLD=0.3
HUB_LAYA_FALLBACK=keyword
# LAYA_CACHE=.laya-cache
# LAYA_DEVICE=webgpu

# --- Model matrix (phone vs hub) ---
# Phone away: Android LiteRT (.litertlm via PHONE_LITERT_FILE). Browser: cached ONNX if prepared.
# Phone on hub Wi-Fi: browser ONNX (GEMMA_MODEL_DIR); native prefers hub /ask.
# Hub text explain: GEMMA_GGUF Q4_0 (llama.cpp). Hub photo/voice: GEMMA_MODEL_DIR ONNX (GGUF has no vision/audio).

# Gemma explanation on the hub. Local GGUF through llama.cpp. Nothing is downloaded.
HUB_EXPLAINER=gemma
GEMMA_RUNTIME=llamacpp
GEMMA_GGUF="C:/Models/gemma/gemma-4-E2B-it-Q4_0.gguf"
# ONNX folder: phone browser chat + HUB_VISION / HUB_VOICE (must be on or off — not on6).
GEMMA_MODEL_DIR="C:/Models/gemma/gemma-4-E2B-it-ONNX"
# GEMMA_DTYPE=q4f16
# GEMMA_DEVICE=cpu
# GEMMA_MAX_WORDS=70
# GEMMA_MAX_NEW_TOKENS=128

# Read photos with the local Gemma 4 ONNX vision model (CPU, about 30 s per photo).
HUB_VISION=on
# VISION_MAX_NEW_TOKENS=128

# Transcribe recordings with the local Gemma 4 ONNX audio model (CPU, shares the photo model).
HUB_VOICE=on
# VOICE_MAX_NEW_TOKENS=192
# MULTIMODAL_DTYPE=q4f16
# AUDIO_DTYPE=

# Serve the Android app's on-phone Gemma 4 E2B (LiteRT-LM) so the app can download it from this hub
# at /models/litert/gemma-4-E2B-it.litertlm (PHONE_LITERT_PATH in shared).
PHONE_LITERT_FILE=E:/models/gemma-4-E2B-it.litertlm

# Pilot logs, one JSON line per event. Keep off git.
HUB_LOG_DIR=logs
