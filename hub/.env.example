# Reference list of hub settings. Copy to hub/.env (gitignored) and the hub loads it at startup.
# The hub, `pnpm eval`, and the hub tests all read this file. Variables already set in your shell win over the file. Every value has a safe default. Nothing here is a secret.

# HTTP listener. 0.0.0.0 serves the whole local network.
HUB_HOST=0.0.0.0
HUB_PORT=8787

# Matcher: keyword (default), laya, or hybrid (keyword first, Laya only when keyword is not sure).
# laya and hybrid need LAYA_PASS_MARK and LAYA_CONFIDENCE_THRESHOLD. Both are team decisions, set before the labeled test.
HUB_MATCHER=keyword
# LAYA_PASS_MARK=
# LAYA_CONFIDENCE_THRESHOLD=

# Laya weights. Default bundle is about 1.69 GB, downloaded once on first use.
# Point LAYA_MODEL_DIR at a local bundle to download nothing. The bundle must be the ONNX export
# (laya.onnx, laya.onnx.data, laya_config.json, tokenizer/). The raw convaiinnovations checkpoint will not load. See README, "Laya bundle".
LAYA_CACHE=.laya-cache
# LAYA_MODEL_DIR=

# If Laya fails to load, keep answering with keyword matching. "keyword" is the default.
HUB_LAYA_FALLBACK=keyword

# Explainer: off (default) or gemma. gemma runs a local Gemma 4 ONNX model (E2B tested) and needs GEMMA_MODEL_DIR.
# If it fails to load, the hub keeps answering with the matched notes only.
HUB_EXPLAINER=off
# GEMMA_MODEL_DIR=E:/models/gemma-4-E2B-it-ONNX
# q4f16 on cpu is the tested route (about 5 tokens per second). DirectML on the GPU gave empty output.
# GEMMA_DTYPE=q4f16
# GEMMA_DEVICE=cpu
# Answers are cut at this many tokens. The phone waits 90 seconds for the hub, so keep it modest.
# GEMMA_MAX_NEW_TOKENS=150

# Pilot logs, one JSON line per event. Keep off git.
HUB_LOG_DIR=logs
